diff --git a/src/backend/c_cfg.c b/src/backend/c_cfg.c
index b8dd283..3af7b54 100644
--- a/src/backend/c_cfg.c
+++ b/src/backend/c_cfg.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-3.0-or-later
 
 #include "backend/c_cfg.h"

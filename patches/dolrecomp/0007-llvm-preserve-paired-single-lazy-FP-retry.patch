 }
diff --git a/src/backend/llvm/register_state.cpp b/src/backend/llvm/register_state.cpp
index f786b00..017f4dd 100644
--- a/src/backend/llvm/register_state.cpp
+++ b/src/backend/llvm/register_state.cpp
@@ -110,6 +110,7 @@ void FunctionEmitter::scanLoopHeaders() {
 
 void FunctionEmitter::scanRegionLeaders() {
   region_leaders_.assign(source_.block_count, false);
+  retry_leaders_.assign(source_.block_count, false);
   if (!source_.block_count)
     return;
   region_leaders_[0] = true;
@@ -136,9 +137,9 @@ void FunctionEmitter::scanRegionLeaders() {
     region_leaders_[(address - source_.guest_start) / 4u] = true;
   }
 
-  // Lazy-FP exceptions retry a faulting scalar FP load/store. Admit that
-  // exact mid-region PC without splitting paired-single regions and losing
-  // their compile-time GQR and packed-state optimization.
+  // Lazy-FP exceptions retry the first faulting FP instruction on a path.
+  // Keep that cold entry separate from the hot region so a retry can reload
+  // architectural state without discarding compile-time GQR knowledge.
   const std::vector<bool> structural_leaders = region_leaders_;
   bool fp_entry_seen = false;
   for (u32 i = 0; i < source_.block_count; i++) {
@@ -151,10 +152,8 @@ void FunctionEmitter::scanRegionLeaders() {
       if (inst.op != DOLIR_OP_HELPER_CALL ||
           inst.aux != DOLIR_HELPER_FP_AVAILABLE)
         continue;
-      const u32 primary = source_.blocks[i].raw >> 26;
-      if (primary < 48u || primary > 55u)
-        continue;
-      region_leaders_[i] = true;
+      if (!region_leaders_[i])
+        retry_leaders_[i] = true;
       fp_entry_seen = true;
       break;
     }
diff --git a/src/backend/llvm/retry_regions.cpp b/src/backend/llvm/retry_regions.cpp
new file mode 100644
index 0000000..dfcb41f
--- /dev/null
+++ b/src/backend/llvm/retry_regions.cpp
@@ -0,0 +1,48 @@
+#include "backend/llvm/emitter.h"
+
+#include <llvm/Support/Format.h>
+#include <llvm/Support/raw_ostream.h>
+
+namespace dolllvm {
+
+using namespace llvm;
+
+bool FunctionEmitter::emitRetryRegion(u32 index, raw_ostream &diagnostics) {
+  resetFPRepresentations();
+  known_state_.fill(nullptr);
+  psq_direct_proven_ = false;
+  psq_indexed_proven_ = false;
+  fp_available_checked_ = false;
+  pending_fprf_ = nullptr;
+  builder_.SetInsertPoint(retry_blocks_[index]);
+  for (u32 current = index; current < source_.block_count; current++) {
+    const DolIRBlock &block = source_.blocks[current];
+    if (current != index && region_leaders_[current]) {
+      materializeFPRF();
+      builder_.CreateBr(blocks_[current]);
+      return true;
+    }
+    if (loop_headers_[current])
+      emitBudgetGuard(block.guest_address);
+    chargeCycles(block.cycle_cost);
+    values_.assign(source_.value_count, nullptr);
+    for (u32 i = 0; i < block.instruction_count; i++) {
+      if (!emitInstruction(block.instructions[i], diagnostics))
+        return false;
+    }
+    if (block.terminator.kind == DOLIR_TERM_FALLTHROUGH) {
+      u32 next = block.terminator.targets[0];
+      if (next != DOLIR_NO_BLOCK && next == current + 1u &&
+          next < source_.block_count && !region_leaders_[next])
+        continue;
+    }
+    materializeFPRF();
+    return emitTerminator(block.terminator, diagnostics);
+  }
+  diagnostics << "dolllvm: unterminated FP retry region at 0x"
+              << format_hex_no_prefix(source_.blocks[index].guest_address, 8)
+              << "\n";
+  return false;
+}
+
+} // namespace dolllvm
diff --git a/tests/cmake/check_llvm_codegen.cmake b/tests/cmake/check_llvm_codegen.cmake
index 68d1ead..ae7ddd3 100644
--- a/tests/cmake/check_llvm_codegen.cmake
+++ b/tests/cmake/check_llvm_codegen.cmake
@@ -141,17 +141,17 @@ execute_process(
 if(NOT fixed_gqr_status EQUAL 0)
     message(FATAL_ERROR "fixed-GQR disassembly failed: ${fixed_gqr_error}")
 endif()
-if(fixed_gqr_disassembly MATCHES "ppc_ps_madd" OR
-   fixed_gqr_disassembly MATCHES "vfm(add|sub)[0-9]*pd")
-    message(FATAL_ERROR "fixed-GQR FMA left its packed-single fast path")
+if(fixed_gqr_disassembly MATCHES "ppc_ps_madd")
+    message(FATAL_ERROR "fixed-GQR FMA still calls an architectural helper")
 endif()
-if(NOT fixed_gqr_disassembly MATCHES "vfm(add|sub)[0-9]*ps")
-    message(FATAL_ERROR "fixed-GQR FMA has no packed-single fused operation")
+if(NOT fixed_gqr_disassembly MATCHES "vfm(add|sub)[0-9]*ps" OR
+   NOT fixed_gqr_disassembly MATCHES "vfm(add|sub)[0-9]*pd")
+    message(FATAL_ERROR
+        "fixed-GQR FMA is missing its hot or cold-retry fused path")
 endif()
-if(fixed_gqr_disassembly MATCHES "jmpq[^\n]*\\*" OR
-   fixed_gqr_disassembly MATCHES "vcvtsd2ss")
+if(fixed_gqr_disassembly MATCHES "vcvtsd2ss")
     message(FATAL_ERROR
-        "fixed-GQR path retained dynamic format dispatch or a store round-trip")
+        "fixed-GQR path retained a packed-store round-trip")
 endif()
 
 execute_process(

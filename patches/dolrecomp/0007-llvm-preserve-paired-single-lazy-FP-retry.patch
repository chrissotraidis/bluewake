--- a/src/backend/llvm/emitter.cpp
+++ b/src/backend/llvm/emitter.cpp
@@ -78,6 +78,7 @@ bool FunctionEmitter::emit(raw_ostream &diagnostics) {
   scanLoopHeaders();
   scanRegionLeaders();

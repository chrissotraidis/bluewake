--- a/src/backend/llvm/control_flow.cpp
+++ b/src/backend/llvm/control_flow.cpp
@@ -101,17 +101,17 @@ void FunctionEmitter::emitFallbackHandler() {
       BasicBlock::Create(context_, "fallback_repeat_check", function_);
   u32 nativeEntries = 0;
   for (u32 i = 0; i < source_.block_count; i++) {
-    nativeEntries += region_leaders_[i] &&
+    nativeEntries += (region_leaders_[i] || retry_leaders_[i]) &&
                      source_.blocks[i].terminator.kind != DOLIR_TERM_FALLBACK;
   }
   auto *dispatch = builder_.CreateSwitch(returnedPC, repeatCheck,
                                          nativeEntries);
   for (u32 i = 0; i < source_.block_count; i++) {
-    if (!region_leaders_[i] ||
+    if ((!region_leaders_[i] && !retry_leaders_[i]) ||
         source_.blocks[i].terminator.kind == DOLIR_TERM_FALLBACK)
       continue;
     dispatch->addCase(builder_.getInt32(source_.blocks[i].guest_address),
-                      blocks_[i]);
+                      retry_leaders_[i] ? retry_blocks_[i] : blocks_[i]);
   }
 
   builder_.SetInsertPoint(repeatCheck);
diff --git a/src/backend/llvm/emitter.cpp b/src/backend/llvm/emitter.cpp

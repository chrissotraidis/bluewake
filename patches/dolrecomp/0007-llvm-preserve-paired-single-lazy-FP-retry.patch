+    CHECK(cpu.exception == PPC_EXC_FP_UNAVAILABLE);
+    CHECK(cpu.srr0 == 0x80003E04u);
+    cpu.exception = 0;
+    cpu.msr |= 1u << 13;
+    cpu.pc = cpu.srr0;
+    func_80003E00(&cpu);
+    CHECK(cpu.fpr[0] == 1.5 && cpu.ps1[0] == 2.0);
+    CHECK(cpu.fpr[1] == 3.0 && cpu.ps1[1] == 4.0);

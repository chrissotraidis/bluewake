   last = std::min(last, passInfo.commands.size());
@@ -3310,8 +3429,13 @@ static void render_pass(const wgpu::RenderPassEncoder& pass, FramePacket& frame,
       else if (passInfo.commands[i].type == CommandType::SetScissor)

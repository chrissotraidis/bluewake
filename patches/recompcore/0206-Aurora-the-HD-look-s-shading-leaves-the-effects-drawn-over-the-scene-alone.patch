     return false;
   bool sea = false;
   if (plan.texmap_mask > 1u && (plan.texmap_mask & (plan.texmap_mask - 1u)) != 0u) {
@@ -546,6 +545,40 @@ bool sea_mask_draw(const gxc::DrawPlan& plan) {

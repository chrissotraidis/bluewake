--- a/GXRuntime/graphics/frontend/include/gxruntime/aurora_recomp/retail_gx_frontend.hpp
+++ b/GXRuntime/graphics/frontend/include/gxruntime/aurora_recomp/retail_gx_frontend.hpp
@@ -151,6 +151,9 @@ private:
   void* event_observer_user_ = nullptr;
   std::uint32_t emitted_trace_count_ = 0;
   std::uint64_t next_packet_sequence_ = 0;

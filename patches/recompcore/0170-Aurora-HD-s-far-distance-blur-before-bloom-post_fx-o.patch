   if (size.width == g_size.width && size.height == g_size.height && g_tex[0]) {
     return;
@@ -179,6 +294,8 @@ void ensure_targets(const wgpu::Extent3D& sceneSize, wgpu::TextureFormat format,
     };
     g_tex[i] = g_device.CreateTexture(&descriptor);

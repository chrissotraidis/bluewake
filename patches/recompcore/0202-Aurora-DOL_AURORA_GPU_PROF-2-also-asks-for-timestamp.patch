From e01f98c6828e48326b08e7e9ab5177f2bd4d7e0e Mon Sep 17 00:00:00 2001
From: irregularthanis <343663069+irregularthanis@users.noreply.github.com>
Date: Fri, 30 Oct 2026 18:40:37 -0500
Subject: [PATCH 202/205] Aurora: DOL_AURORA_GPU_PROF=2 also asks for timestamp
 queries

The device requested them for =1 only, so =2 left the profiler without
timestamps and it logged nothing.
---
 GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp b/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
index 0325aca8e8..271d0f3c26 100644
--- a/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
+++ b/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
@@ -954,13 +954,13 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
       }
 #endif
       // Timestamps for the GPU profiler (gpu_prof.cpp): Tracy builds, and
-      // DOL_AURORA_GPU_PROF=1, which logs each pass's GPU time to stderr.
+      // DOL_AURORA_GPU_PROF=1 or 2, which log each pass's GPU time to stderr.
       if (feature == wgpu::FeatureName::TimestampQuery) {
 #ifdef TRACY_ENABLE
         requiredFeatures.push_back(feature);
 #else
         const char* profEnv = std::getenv("DOL_AURORA_GPU_PROF");
-        if (profEnv != nullptr && profEnv[0] == '1') {
+        if (profEnv != nullptr && (profEnv[0] == '1' || profEnv[0] == '2')) {
           requiredFeatures.push_back(feature);
         }
 #endif
-- 

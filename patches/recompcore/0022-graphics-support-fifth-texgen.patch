     for (std::uint32_t e = 0; e < walk.entry_count; ++e) {
@@ -899,9 +901,13 @@ DrawPlan GxCoreState::build_draw_plan(const ar::ConsumedDraw& draw,
         // GX per-vertex TEXMTXIDX: the byte is a matrix-memory row index (GX

+      uint32_t frames = 0;
+      ok = std::fread(&frames, 4, 1, f) == 1 && frames > 0 && frames <= 4096;
+      std::vector<std::array<float, 3>> curve(ok ? frames : 0);
+      ok = ok && std::fread(curve.data(), sizeof(curve[0]), curve.size(), f) == curve.size();
+      out->curves.push_back(std::move(curve));

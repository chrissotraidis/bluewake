+  }
+  // Night (Windfall 21:00): K = actor_k0 x 1.0.
+  gxc::HdActorLightConstants night = day;
+  const float night_c0[3] = {0.118f, 0.310f, 0.314f}, night_sh[3] = {0.f, 0.157f, 0.353f},
+              night_k[3] = {0.188f, 0.392f, 0.529f};
+  for (int i = 0; i < 3; ++i) {

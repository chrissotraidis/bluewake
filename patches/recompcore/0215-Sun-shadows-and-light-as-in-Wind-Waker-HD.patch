+  const wgpu::TexelCopyTextureInfo to{.texture = g_sunHist};
+  const wgpu::Extent3D extent{g_sunLowSize.width, g_sunLowSize.height, 1};
+  cmd.CopyTextureToTexture(&from, &to, &extent);

+// The quarter-size targets of HD's terrain mix, for a scene of `size` (half the size in HD's pass, as its pre-pass).
+void ensure_sun_low(const wgpu::Extent3D& size) {
+  const uint32_t div = g_sunHdPrepass ? 2u : 4u;

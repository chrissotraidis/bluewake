+  gxc::HdActorLightConstants day{};
+  const float day_c0[3] = {0.494f, 0.416f, 0.294f}, day_sh[3] = {0.106f, 0.384f, 0.710f},
+              day_k[3] = {2.75f, 2.588f, 1.801f};

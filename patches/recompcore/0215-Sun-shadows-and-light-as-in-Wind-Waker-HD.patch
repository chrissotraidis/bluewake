+    std::fprintf(stderr, "[sun-facing] HD light: %zu of %zu vertices HD's colours, shade %d,%d,%d light %d,%d,%d\n",
+                 hits, count, c[0], c[1], c[2], k[0], k[1], k[2]);
+}

+bool fog_hd_start(float& start, float& end) noexcept {
+  std::lock_guard lock{g_sceneFogMutex};
+  start = g_fogHdStarts[0];
+  end = g_fogHdStarts[1];
+  return end > 0.f && start < 0.f;
+}

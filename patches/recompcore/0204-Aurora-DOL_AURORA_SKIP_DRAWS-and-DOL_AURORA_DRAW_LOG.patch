From 8d7beeab7c5aecf5f7ed89b4db99b34e34d9d450 Mon Sep 17 00:00:00 2001
From: irregularthanis <343663069+irregularthanis@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:36:46 -0500
Subject: [PATCH 204/205] Aurora: DOL_AURORA_SKIP_DRAWS and DOL_AURORA_DRAW_LOG
 for a pass's draws

PASS:FIRST-LAST. SKIP_DRAWS leaves those commands of the pass out, in real
and in-between frames, to see what they draw and what they cost. DRAW_LOG
logs them once (the 300th real frame): each draw's pipeline state (TEV
stages, blending, depth test and write, alpha test), indices, vertex bytes
and texture bind group. Pipeline states are kept only while DRAW_LOG is set.
Diagnostics; unset, nothing changes.
---
 GXRuntime/graphics/aurora/lib/gfx/common.cpp | 70 ++++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/GXRuntime/graphics/aurora/lib/gfx/common.cpp b/GXRuntime/graphics/aurora/lib/gfx/common.cpp
index 81985348ee..77630fe8db 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/common.cpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/common.cpp
@@ -1091,6 +1091,24 @@ void push_draw_command(rmlui::DrawData data) {
 }
 #endif
 
+// DOL_AURORA_SKIP_DRAWS / DOL_AURORA_DRAW_LOG=PASS:FIRST-LAST (diagnostics):
+// the commands FIRST to LAST of the frame's pass PASS.
+struct PassRange {
+  bool set = false;
+  uint32_t pass = 0;
+  size_t first = 0, last = 0;
+};
+static PassRange pass_range(const char* name) {
+  PassRange range;
+  const char* env = std::getenv(name);
+  unsigned pass = 0;
+  unsigned long long first = 0, last = 0;
+  if (env != nullptr && std::sscanf(env, "%u:%llu-%llu", &pass, &first, &last) == 3 && first <= last)
+    range = {.set = true, .pass = pass, .first = static_cast<size_t>(first), .last = static_cast<size_t>(last)};
+  return range;
+}
+static const PassRange g_skipDraws = pass_range("DOL_AURORA_SKIP_DRAWS");
+static const PassRange g_drawLog = pass_range("DOL_AURORA_DRAW_LOG");
 #ifdef AURORA_ENABLE_GXCORE

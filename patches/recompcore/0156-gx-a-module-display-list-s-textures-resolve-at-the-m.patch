diff --git a/GXRuntime/graphics/frontend/tests/frontend_replay_test.cpp b/GXRuntime/graphics/frontend/tests/frontend_replay_test.cpp
index 359cdba8e3..7f5d4e4c1a 100644
--- a/GXRuntime/graphics/frontend/tests/frontend_replay_test.cpp
+++ b/GXRuntime/graphics/frontend/tests/frontend_replay_test.cpp
@@ -613,6 +613,53 @@ void test_tlut_written_after_image_selects_palette() {
   assert(bound_format == 2u);

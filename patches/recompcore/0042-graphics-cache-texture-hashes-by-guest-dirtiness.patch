+    const uint32_t tlutSize =
+        gxc::is_ci_format(format) && has_tlut && tlut_data != nullptr
+            ? std::min(tlut_available, tlut_entries * 2u)
+            : 0u;
+    const bool tlutEpochValid =
+        tlutSize == 0u ||
+        (g_textureDirtyEpochObserver != nullptr &&

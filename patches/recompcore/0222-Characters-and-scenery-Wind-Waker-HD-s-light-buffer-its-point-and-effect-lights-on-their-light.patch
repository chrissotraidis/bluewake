+  lights.pos_r[0][1] = 0.f;
+  lights.pos_r[0][2] = 200.f;
+  lights.pos_r[0][3] = 381.3f;
+  lights.colour[0][0] = 600.f / 255.f;
+  lights.colour[0][1] = 400.f / 255.f;
+  lights.colour[0][2] = 120.f / 255.f;

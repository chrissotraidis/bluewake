From 8336a009928ef0d094221d786f327ee19e046149 Mon Sep 17 00:00:00 2001
From: James Koehler-Killeen <kohlykohl@gmail.com>
Date: Tue, 3 Nov 2026 16:38:50 -0600
Subject: [PATCH] GXRuntime: the FIFO stream position, and a present served
 once per turn

A draw-done commit has to drain the translation worker before it can raise the
PE finish, so the guest stands still for the tail of its own frame. The console
did not: Gekko wrote the FIFO and carried on. Giving the host the two numbers it
needs to defer instead is this change:

- gx_position publishes what the FIFO write path has buffered and reports the
  parsed count, so a host that records it at GXDrawDone's return has a stream
  position to wait for rather than a worker to drain. Zero - no worker, a traced
  frame, a headless build - is the host's signal to keep its drain.
- gx_parsed is that count on its own, read once per turn.
- gx_service serves the present the worker stopped at, once per turn, and takes
  the display-copy flag atomically so two turns cannot both present.

BlueWake's host half (the BLUEWAKE_DRAW_DONE_OVERLAP switch) is what reads them.
---
 GXRuntime/backends/aurora/aurora_backend.cpp  |  3 ++
 .../backends/aurora/aurora_backend_private.h  |  3 ++
 GXRuntime/backends/aurora/aurora_graphics.cpp | 40 +++++++++++++++++++
 GXRuntime/include/gxruntime/platform.h        | 19 +++++++++
 GXRuntime/src/platform.c                      | 12 ++++++
 5 files changed, 77 insertions(+)

diff --git a/GXRuntime/backends/aurora/aurora_backend.cpp b/GXRuntime/backends/aurora/aurora_backend.cpp
index 2c64fda..5e8eb87 100644
--- a/GXRuntime/backends/aurora/aurora_backend.cpp
+++ b/GXRuntime/backends/aurora/aurora_backend.cpp
@@ -225,6 +225,9 @@ void install_platform_ops() {
         // records each write with its size.
         .gx_write_bytes = g_gx_core_enabled && !g_trace_armed ? aurora_backend_gx_write_bytes : nullptr,
         .gx_flush = aurora_backend_gx_flush,
+        .gx_position = aurora_backend_gx_position,
+        .gx_parsed = aurora_backend_gx_parsed,
+        .gx_service = aurora_backend_gx_service,
         .gx_read_draw_sync = aurora_backend_gx_read_draw_sync,
         .call_display_list = aurora_backend_call_display_list,
         .call_display_list_guest = aurora_backend_call_display_list_guest,
diff --git a/GXRuntime/backends/aurora/aurora_backend_private.h b/GXRuntime/backends/aurora/aurora_backend_private.h
index 994bcd3..0d3fca6 100644
--- a/GXRuntime/backends/aurora/aurora_backend_private.h
+++ b/GXRuntime/backends/aurora/aurora_backend_private.h
@@ -203,6 +203,9 @@ void aurora_backend_mark_gx_begin(void);
 void aurora_backend_gx_write(u64 value, u8 size);
 void aurora_backend_gx_write_bytes(const u8* bytes, u32 size);
 void aurora_backend_gx_flush(void);
+u32 aurora_backend_gx_position(void);
+u32 aurora_backend_gx_parsed(void);
+bool aurora_backend_gx_service(void);
 bool aurora_backend_gx_read_draw_sync(u16* token);
 void aurora_backend_call_display_list(const void* data, u32 size);
 void aurora_backend_call_display_list_guest(u32 guest_address, const void* data, u32 size);
diff --git a/GXRuntime/backends/aurora/aurora_graphics.cpp b/GXRuntime/backends/aurora/aurora_graphics.cpp
index e173087..36eba76 100644
--- a/GXRuntime/backends/aurora/aurora_graphics.cpp
+++ b/GXRuntime/backends/aurora/aurora_graphics.cpp
@@ -1851,6 +1851,46 @@ void aurora_backend_gx_flush(void) {
 #endif
 }
 
+// The stream position a draw-done is deferred to. Publishing here is what gives
+// the worker this frame to translate: the host records the position at
+// GXDrawDone's return, then compares it with the parsed count on each turn
+// instead of standing still until the stream has been translated.
+u32 aurora_backend_gx_position(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (!gx_aurora::g_initialized || !gx_aurora::g_shadow_frontend_enabled ||
+        !gx_aurora::g_fifo_worker_started ||
+        gx_aurora::g_shadow_frontend_failed.load(std::memory_order_relaxed))
+        return 0u;
+    gx_aurora::g_fifo_publish_local();
+    return static_cast<u32>(gx_aurora::g_fifo_parsed);
+#else
+    return 0u;
+#endif
+}
+
+u32 aurora_backend_gx_parsed(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    return static_cast<u32>(gx_aurora::g_fifo_parsed);
+#else
+    return 0u;
+#endif
+}
+
+// The present the worker stopped at, served once per turn: what the drain used
+// to reach on its way to raising the finish.
+bool aurora_backend_gx_service(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (!gx_aurora::g_initialized || !gx_aurora::g_gx_core_enabled)
+        return false;
+    if (!gx_aurora::g_display_copy_pending.exchange(false, std::memory_order_relaxed))
+        return false;
+    aurora_backend_present();
+    return true;
+#else
+    return false;
+#endif
+}
+
 // A run of consecutive gather-pipe writes as their bytes in guest order (the
 // game module's batch). Installed only where the FIFO is a byte stream - the
 // GX core on and nothing traced (install_platform_ops) - so a byte at a time
diff --git a/GXRuntime/include/gxruntime/platform.h b/GXRuntime/include/gxruntime/platform.h
index 80fe015..f932495 100644
--- a/GXRuntime/include/gxruntime/platform.h
+++ b/GXRuntime/include/gxruntime/platform.h
@@ -37,6 +37,16 @@ typedef struct DolPlatformOps {
     // matter to it). NULL where they do: the host then sends writes one by one.
     void (*gx_write_bytes)(const u8* bytes, u32 size);
     void (*gx_flush)(void);
+    // The FIFO stream position a draw-done may be deferred to, and how much
+    // of it the backend has parsed: a backend with a translation worker
+    // publishes what the write path has buffered as its position, and reports
+    // its parsed count per turn. Zero from either means there is no worker to
+    // defer to, and the host keeps the drain it would otherwise take.
+    u32 (*gx_position)(void);
+    u32 (*gx_parsed)(void);
+    // Serve the present the worker stopped at, once per turn. False when
+    // nothing is waiting.
+    bool (*gx_service)(void);
     bool (*gx_read_draw_sync)(u16* token);
     void (*call_display_list)(const void* data, u32 size);
     // The same with the list's guest address, for a backend that needs to
@@ -93,6 +103,15 @@ void dol_platform_gx_write_bytes(const u8* bytes, u32 size);
 // guest is about to observe GPU progress - the draw-done commit - so the
 // translation is never behind a wait it is supposed to satisfy.
 void dol_platform_gx_flush(void);
+// The stream position to defer a draw-done to, and the parsed count a turn
+// compares it against. dol_platform_gx_position publishes what the FIFO write
+// path has buffered, so a backend with a worker has the frame to translate;
+// zero means none of them can (no worker, a traced frame, a headless build)
+// and the host must keep its drain.
+u32 dol_platform_gx_position(void);
+u32 dol_platform_gx_parsed(void);
+// The present the worker stopped at, served once per turn.
+bool dol_platform_gx_service(void);
 // Drain submitted commands and read the last decoded interrupt token.
 // False means no token was decoded or the backend cannot provide it.
 bool dol_platform_gx_read_draw_sync(u16* token);
diff --git a/GXRuntime/src/platform.c b/GXRuntime/src/platform.c
index 368a050..a0c6673 100644
--- a/GXRuntime/src/platform.c
+++ b/GXRuntime/src/platform.c
@@ -65,6 +65,18 @@ void dol_platform_gx_flush(void) {
         g_ops.gx_flush();
 }
 
+u32 dol_platform_gx_position(void) {
+    return g_ops.gx_position != NULL ? g_ops.gx_position() : 0u;
+}
+
+u32 dol_platform_gx_parsed(void) {
+    return g_ops.gx_parsed != NULL ? g_ops.gx_parsed() : 0u;
+}
+
+bool dol_platform_gx_service(void) {
+    return g_ops.gx_service != NULL && g_ops.gx_service();
+}
+
 bool dol_platform_gx_read_draw_sync(u16* token) {
     return token != NULL && g_ops.gx_read_draw_sync != NULL &&
            g_ops.gx_read_draw_sync(token);
-- 
2.56.0


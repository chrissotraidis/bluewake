From caeedd81d24fbc0ecc91b0dd9e4d5404023d5a00 Mon Sep 17 00:00:00 2001
From: irregularthanis <343663069+irregularthanis@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:38:43 -0500
Subject: [PATCH 194/196] Track every guest alias registry mutation

---
 GXRuntime/src/core/cpu.c                   |  4 +++-
 GXRuntime/tests/guest_memory_bounds_test.c | 11 +++++++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/GXRuntime/src/core/cpu.c b/GXRuntime/src/core/cpu.c
index 40191e644e..1559c0c840 100644
--- a/GXRuntime/src/core/cpu.c
+++ b/GXRuntime/src/core/cpu.c
@@ -115,7 +115,6 @@ u32 g_ppc_guest_alias_generation;
 
 static void ppc_guest_alias_set_overlap_mem1(bool overlaps) {
     g_ppc_guest_aliases_overlap_mem1 = overlaps;
-    g_ppc_guest_alias_generation++;
 }
 // Cost census for the alias path (docs/status/REORGANIZATION_2026-09-17.md, W4).
 // get_ram_ptr sends every untagged MEM1 access through ppc_guest_alias_resolve
@@ -183,6 +182,7 @@ GXRUNTIME_EXPORT void ppc_guest_alias_clear(void) {
     g_guest_alias_max_end = 0u;
     g_guest_alias_overlapping = false;
     ppc_guest_alias_set_overlap_mem1(false);
+    g_ppc_guest_alias_generation++;
 }
 
 static bool ppc_guest_alias_add_storage(u32 linked_start, u32 size,
@@ -205,6 +205,7 @@ static bool ppc_guest_alias_add_storage(u32 linked_start, u32 size,
     if (alias->linked_start < GC_MEM1_ADDRESS_END &&
         alias_end > GC_RAM_BASE)
         ppc_guest_alias_set_overlap_mem1(true);
+    g_ppc_guest_alias_generation++;
     if (getenv("BLUEWAKE_TRACE_GUEST_ALIASES") != NULL &&
         alias->linked_start < 0x81516E20u &&
         (u64)alias->linked_start + alias->size > 0x81512AC0u) {
@@ -265,6 +266,7 @@ GXRUNTIME_EXPORT bool ppc_guest_alias_remove(u32 linked_start, u32 size) {
         g_guest_aliases[g_guest_alias_count] = (PPCGuestAlias){0};
         ppc_guest_alias_index_rebuild();
         ppc_guest_alias_recompute_bounds();
+        g_ppc_guest_alias_generation++;
         return true;
     }
     return false;
diff --git a/GXRuntime/tests/guest_memory_bounds_test.c b/GXRuntime/tests/guest_memory_bounds_test.c
index aa4aed5516..59c5f3c332 100644
--- a/GXRuntime/tests/guest_memory_bounds_test.c
+++ b/GXRuntime/tests/guest_memory_bounds_test.c
@@ -27,6 +27,17 @@ int main(void) {
     cpu.exram = exram; cpu.exram_size = sizeof exram;
     ppc_guest_alias_clear();
     assert(!ppc_guest_alias_range_overlaps(GC_RAM_BASE, 4));
+    u32 alias_generation = g_ppc_guest_alias_generation;
+    assert(ppc_guest_alias_add_shared(0x8C008000u, sizeof overlap_alias,
+                                      overlap_alias));
+    assert(g_ppc_guest_alias_generation != alias_generation);
+    assert(ppc_guest_alias_range_overlaps(0x8C008000u, 1u));
+    alias_generation = g_ppc_guest_alias_generation;
+    assert(ppc_guest_alias_remove(0x8C008000u, sizeof overlap_alias));
+    assert(g_ppc_guest_alias_generation != alias_generation);
+    alias_generation = g_ppc_guest_alias_generation;
+    ppc_guest_alias_clear();
+    assert(g_ppc_guest_alias_generation != alias_generation);
     u32 offset = 123;
     assert(get_ram_ptr(&cpu, GC_RAM_BASE, 4, &offset) == bw_test_mem1 && offset == 0);
     const u32 ram_size = sizeof bw_test_mem1;
-- 
2.46.0


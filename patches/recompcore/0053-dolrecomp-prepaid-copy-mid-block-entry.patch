+/* The prepaid copy's observation correction.
+ *
+ * The single body flips cycle_block_prepaid back to false here and carries on,
+ * because it has a per-instruction charge to fall back to. The prepaid copy has
+ * none: giving the unexecuted cycles back and clearing a flag would leave the
+ * rest of the block uncharged. It hands the observing instruction to the precise
+ * copy at that address instead, which charges it and the rest of the block one
+ * instruction at a time - the same state the flag flip produces.
+ *
+ * This is not optional, and that is what the parked copy was missing. The
+ * deadline budget is not fixed within a block: the host recomputes it every time
+ * the guest observes the cycle domain (bluewake_cycle_domain_observe ->
+ * bounded_budget), and the observing instructions are the loads and stores. So a
+ * leader-time guard cannot stand in for a reconcile that runs where the
+ * observation does. docs/status/CURRENT.md, 2026-09-22. */
+static void emit_fast_observation_reconcile(FILE* out, const PPCInst* inst,
+                                            u32 resume, u32 func_addr) {
+    if (!instruction_may_observe_cycle_domain(inst))
+        return;
+    fprintf(out, "    if (ctx->cycle_deadline_budget > 0 &&\n");
+    fprintf(out, "        (s64)ctx->cycle_observation_suffix > "
+                 "ctx->cycle_deadline_budget) {\n");
+    fprintf(out, "        ctx->downcount += "
+                 "(s64)ctx->cycle_observation_suffix;\n");
+    if (resume != 0u) {
+        fprintf(out, "        ctx->pc = 0x%08Xu;\n", resume);
+        fprintf(out, "        func_%08X_precise(ctx);\n", func_addr);
+    } else {
+        fprintf(out, "        ctx->pc = 0x%08Xu;\n", func_addr);
+    }
+    fprintf(out, "        return;\n");
+    fprintf(out, "    }\n");
+}

 .../graphics/aurora/lib/gfx/gxcore_draw.cpp   | 16 ++++++---
 .../graphics/aurora/lib/gfx/gxcore_draw.hpp   |  2 ++
 .../include/gxruntime/guest_memory_dirty.h    |  9 +++++
 GXRuntime/src/guest_memory_dirty.c            | 33 ++++++++++++++-----
 GXRuntime/tests/runtime_tests.c               | 16 +++++++++
 9 files changed, 74 insertions(+), 13 deletions(-)


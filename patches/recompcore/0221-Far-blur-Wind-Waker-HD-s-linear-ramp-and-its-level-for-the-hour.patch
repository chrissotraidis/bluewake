From 3f9b36233ee8e6fbf555ed4f6ad779fb41a4e432 Mon Sep 17 00:00:00 2001
From: pdale-boop <237306950+pdale-boop@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:08:26 -0600
Subject: [PATCH] Far blur: Wind Waker HD's linear ramp and its level for the
 hour

Wind Waker HD's far blur (its DOF composite, PS 786 at event 4637 in the noon capture at Windfall) blends by
clamp(level x (z / 25,000 - 1)): wwHD_basic.bagldof has level 1.2, start 25,000 and end 50,000, so the far scene is
sharp to 25,000 and fully blended from 45,833; wwHD_night has level 0.65 at the same distances, and HD blends the
two presets over 06:00-08:00 and 18:00-20:00 (d_kankyo_4.cpp). Aurora's blend was smoothstep(8,000, 30,000), so the
islands at middle distance were softer than HD's.

DOL_AURORA_FAR_BLUR_HD=1 takes HD's ramp in place of the smoothstep: clamp(level x (distance - start) / (end -
start)), times DOL_AURORA_FAR_BLUR_AMOUNT as before (Aurora's blurred picture is a quarter of the size, much softer
than HD's at a 1080p frame, so the amount keeps it in check). The level comes from the host,
aurora_set_far_blur_level() (1.2 until set), through a small uniform: the composite now has a layout of its own,
g_depthLayout's sampler, blurred scene and depth plus the uniform, drawn with draw_with_uniform(). Without the switch
the result is the smoothstep as before.

The far shader compiles with Dawn (Vulkan); gxcore tests pass.
---
 .../graphics/aurora/include/aurora/aurora.h   |  4 ++
 GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp | 64 ++++++++++++++++++-
 GXRuntime/graphics/aurora/lib/gfx/post_fx.hpp |  5 +-
 3 files changed, 69 insertions(+), 4 deletions(-)

diff --git a/GXRuntime/graphics/aurora/include/aurora/aurora.h b/GXRuntime/graphics/aurora/include/aurora/aurora.h
index bc8c134b14..072975838a 100644
--- a/GXRuntime/graphics/aurora/include/aurora/aurora.h
+++ b/GXRuntime/graphics/aurora/include/aurora/aurora.h
@@ -175,6 +175,10 @@ void aurora_set_bloom(bool enabled);
    sharp, before bloom. Takes effect at the next frame. DOL_AURORA_FAR_BLUR=1
    sets the starting value. */
 void aurora_set_far_blur(bool enabled);
+/* Wind Waker HD's far blur level for the hour (its DOF presets: wwHD_basic 1.2 by day, wwHD_night 0.65, blended
+   over 06:00-08:00 and 18:00-20:00), used with DOL_AURORA_FAR_BLUR_HD=1: the blend is clamp(level x (distance -
+   start) / (end - start)) times DOL_AURORA_FAR_BLUR_AMOUNT. 1.2 until set. Takes effect at the next frame. */
+void aurora_set_far_blur_level(float level);
 /* Ambient occlusion: creases and contact areas darkened, from the scene's
    depth, before the far blur and bloom. Takes effect at the next frame.
    DOL_AURORA_AO=1 sets the starting value. */
diff --git a/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp b/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp
index 1817518fc1..256479792a 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp
@@ -435,6 +435,11 @@ float g_farStart = 8000.f;  // distance in near-plane units where the far blur s
 float g_farEnd = 30000.f;   // and where it is full
 float g_farAmount = 0.8f;  // how much of the blurred scene at full
 float g_farBackground = 0.35f;  // and where there is no depth (the sky, the horizon)
+// DOL_AURORA_FAR_BLUR_HD=1: Wind Waker HD's ramp (wwHD_basic's DOF) in place of the smoothstep: the blend is
+// clamp(level x (distance - start) / (end - start)), times the amount, with the level the host gives for the hour
+// (aurora_set_far_blur_level: HD's 1.2 by day, 0.65 at night).
+bool g_farHd = false;
+std::atomic<float> g_farLevel{1.2f};
 bool g_farDebug = false;
 float g_threshold = 0.72f;
 float g_strength = 0.35f;
@@ -475,6 +480,10 @@ std::array<wgpu::TextureView, 2> g_aoView;
 uint32_t g_farSamples = 0;
 wgpu::BindGroupLayout g_depthLayout;
 wgpu::PipelineLayout g_depthPipelineLayout;
+// The far blur's composite: g_depthLayout's sampler, blurred scene and depth, then its uniform (HD's level) at 3 and
+// an unused texture at 4, as draw_with_uniform() binds them.
+wgpu::BindGroupLayout g_farLayout;
+wgpu::PipelineLayout g_farPipelineLayout;
 std::array<wgpu::Texture, 2> g_farTex;
 std::array<wgpu::TextureView, 2> g_farView;
 uint32_t g_compositeSamples = 0;
@@ -696,10 +705,14 @@ override far_end: f32 = 30000.0;
 override amount: f32 = 0.8;
 override background: f32 = 0.35;
 override debug_view: bool = false;
+// Wind Waker HD's ramp (g_farHd): clamp(level x (distance - start) / (end - start)) x amount, linear, with HD's DOF
+// level for the hour in far_u.x (1.2 by day: full at 45,833 of 25,000 to 50,000; 0.65 at night: 0.65 at 50,000).
+override hd_ramp: bool = false;
 
 @group(0) @binding(0) var samp: sampler;
 @group(0) @binding(1) var blurred: texture_2d<f32>;
 @group(0) @binding(2) var depth: texture_depth_2d;
+@group(0) @binding(3) var<uniform> far_u: vec4<f32>;
 
 struct VertexOutput {
     @builtin(position) pos: vec4<f32>,
@@ -722,7 +735,12 @@ fn fs_far(in: VertexOutput) -> @location(0) vec4<f32> {
     let d = textureLoad(depth, vec2<i32>(in.pos.xy), 0);
     // No depth: what the game draws behind the scene without it (the sky, the
     // sea toward the horizon, the islands' far models).
-    var f = select(smoothstep(far_start, far_end, 1.0 / max(d, 1e-9)) * amount, background, d <= 0.0);
+    let dist = 1.0 / max(d, 1e-9);
+    var ramp = smoothstep(far_start, far_end, dist);
+    if (hd_ramp) {
+        ramp = clamp(far_u.x * clamp((dist - far_start) / (far_end - far_start), 0.0, 1.0), 0.0, 1.0);
+    }
+    var f = select(ramp * amount, background, d <= 0.0);
     // Within the blur's reach of where there is no depth, less of it, as much
     // less as the sky is left sharp: there the blurred picture is part sky,
     // and with the sky sharp the sea along the horizon took a bright band and
@@ -2885,6 +2903,7 @@ wgpu::RenderPipeline make_far_pipeline(wgpu::TextureFormat format, uint32_t samp
       wgpu::ConstantEntry{.key = "amount", .value = g_farAmount},
       wgpu::ConstantEntry{.key = "background", .value = g_farBackground},
       wgpu::ConstantEntry{.key = "debug_view", .value = g_farDebug ? 1.0 : 0.0},
+      wgpu::ConstantEntry{.key = "hd_ramp", .value = g_farHd ? 1.0 : 0.0},
   };
   const wgpu::BlendState over{
       .color = {.operation = wgpu::BlendOperation::Add,
@@ -2905,7 +2924,7 @@ wgpu::RenderPipeline make_far_pipeline(wgpu::TextureFormat format, uint32_t samp
   };
   const wgpu::RenderPipelineDescriptor descriptor{
       .label = "Far blur composite",
-      .layout = g_depthPipelineLayout,
+      .layout = g_farPipelineLayout,
       .vertex = {.module = g_farModule, .entryPoint = "vs_main"},
       .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
       .multisample = {.count = samples, .mask = UINT32_MAX},
@@ -4066,6 +4085,10 @@ void initialize() {
   g_farEnd = env_float("DOL_AURORA_FAR_BLUR_END", g_farEnd, g_farStart + 1.f, 1e9f);
   g_farAmount = env_float("DOL_AURORA_FAR_BLUR_AMOUNT", g_farAmount, 0.f, 1.f);
   g_farBackground = env_float("DOL_AURORA_FAR_BLUR_BACKGROUND", g_farBackground, 0.f, 1.f);
+  {
+    const char* hd = std::getenv("DOL_AURORA_FAR_BLUR_HD");
+    g_farHd = hd != nullptr && hd[0] == '1';
+  }
   const char* ao = std::getenv("DOL_AURORA_AO");
   g_ao.store(ao != nullptr && ao[0] == '1', std::memory_order_relaxed);
   g_aoRadius = env_float("DOL_AURORA_AO_RADIUS", g_aoRadius, 0.1f, 1e6f);
@@ -4283,6 +4306,31 @@ void initialize() {
   const wgpu::PipelineLayoutDescriptor depthPipelineLayoutDescriptor{.bindGroupLayoutCount = 1,
                                                                      .bindGroupLayouts = &g_depthLayout};
   g_depthPipelineLayout = g_device.CreatePipelineLayout(&depthPipelineLayoutDescriptor);
+  const std::array farEntries{
+      depthEntries[0],
+      depthEntries[1],
+      depthEntries[2],
+      wgpu::BindGroupLayoutEntry{
+          .binding = 3,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .buffer = {.type = wgpu::BufferBindingType::Uniform, .minBindingSize = 16},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 4,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture = {.sampleType = wgpu::TextureSampleType::UnfilterableFloat,
+                      .viewDimension = wgpu::TextureViewDimension::e2D},
+      },
+  };
+  const wgpu::BindGroupLayoutDescriptor farLayoutDescriptor{
+      .label = "Far blur composite",
+      .entryCount = farEntries.size(),
+      .entries = farEntries.data(),
+  };
+  g_farLayout = g_device.CreateBindGroupLayout(&farLayoutDescriptor);
+  const wgpu::PipelineLayoutDescriptor farPipelineLayoutDescriptor{.bindGroupLayoutCount = 1,
+                                                                   .bindGroupLayouts = &g_farLayout};
+  g_farPipelineLayout = g_device.CreatePipelineLayout(&farPipelineLayoutDescriptor);
   // Binding 1 is the exposure's sea mask, or for the cloud shadows and the
   // screen's sun shadows the effects' mask (both read with textureLoad); the
   // edge light leaves it.
@@ -4523,6 +4571,8 @@ void shutdown() {
   g_farSamples = 0;
   g_depthPipelineLayout = {};
   g_depthLayout = {};
+  g_farPipelineLayout = {};
+  g_farLayout = {};
   g_farModule = {};
   g_size = {};
   g_format = wgpu::TextureFormat::Undefined;
@@ -4545,6 +4595,10 @@ void set_cloud_hd_floor(float floor) noexcept {
   g_cloudHdFloor.store(floor >= 0.f ? std::min(floor, 1.f) : -1.f, std::memory_order_relaxed);
 }
 
+void set_far_blur_level(float level) noexcept {
+  g_farLevel.store(std::clamp(level, 0.f, 4.f), std::memory_order_relaxed);
+}
+
 bool ambient_occlusion_enabled() noexcept { return g_ao.load(std::memory_order_relaxed) && webgpu::g_hasCoreFeatures; }
 
 void set_ambient_occlusion(bool enabled) noexcept { g_ao.store(enabled, std::memory_order_relaxed); }
@@ -5560,7 +5614,9 @@ void encode(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& scene, con
       draw(cmd, "Far blur (horizontal)", g_blurH, g_farView[0], g_farView[1], false);
       draw(cmd, "Far blur (vertical)", g_blurV, g_farView[1], g_farView[0], false);
     }
-    draw_depth(cmd, "Far blur composite", g_farComposite, g_farView[0], depthView, dst, resolve, true);
+    const std::array<float, 4> far{g_farLevel.load(std::memory_order_relaxed), 0.f, 0.f, 0.f};
+    draw_with_uniform(cmd, "Far blur composite", g_farComposite, g_farLayout, far.data(), sizeof far, depthView, dst,
+                      resolve, &g_farView[0]);
   }
   if (camera.exposure > 1.f && g_module && size.width >= 4 && size.height >= 4) {
     const webgpu::gpu_prof::Zone zone{cmd, "Exposure"};
@@ -5605,6 +5661,8 @@ void aurora_set_bloom(bool enabled) { aurora::gfx::post_fx::set_bloom(enabled);
 
 void aurora_set_far_blur(bool enabled) { aurora::gfx::post_fx::set_far_blur(enabled); }
 
+void aurora_set_far_blur_level(float level) { aurora::gfx::post_fx::set_far_blur_level(level); }
+
 void aurora_set_ambient_occlusion(bool enabled) { aurora::gfx::post_fx::set_ambient_occlusion(enabled); }
 
 void aurora_set_cloud_shadows(bool enabled) { aurora::gfx::post_fx::set_cloud_shadows(enabled); }
diff --git a/GXRuntime/graphics/aurora/lib/gfx/post_fx.hpp b/GXRuntime/graphics/aurora/lib/gfx/post_fx.hpp
index ece021d8b1..37ce8b2ba8 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/post_fx.hpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/post_fx.hpp
@@ -19,7 +19,9 @@
 // DOL_AURORA_FAR_BLUR_AMOUNT (default 0.8); where the game drew without depth
 // (the sky, the horizon, the islands' far models), _BACKGROUND (default 0.35). Off unless
 // DOL_AURORA_FAR_BLUR=1 or aurora_set_far_blur(true); _DEBUG=1 shows the
-// distance as brightness.
+// distance as brightness. _HD=1: Wind Waker HD's linear ramp in place of the
+// smoothstep, clamp(level x (distance - start) / (end - start)) x the amount,
+// the level the host's for the hour (aurora_set_far_blur_level).
 //
 // Ambient occlusion (HD's darkened creases and contact shadows): first, from
 // depth alone, at a quarter of the size, blurred and multiplied into the
@@ -52,6 +54,7 @@ bool bloom_enabled() noexcept;
 void set_bloom(bool enabled) noexcept;
 bool far_blur_enabled() noexcept;
 void set_far_blur(bool enabled) noexcept;
+void set_far_blur_level(float level) noexcept;
 bool ambient_occlusion_enabled() noexcept;
 void set_ambient_occlusion(bool enabled) noexcept;
 bool torch_light_enabled() noexcept;

     for (int c = 0; c < 4; ++c)
       out[r][c] = a[r][0] * b[0][c] + a[r][1] * b[1][c] + a[r][2] * b[2][c];
@@ -321,6 +347,7 @@ void vote_motion(const float current[][4], const float previous[][4]) {
       m[r][3] += current[r][3];

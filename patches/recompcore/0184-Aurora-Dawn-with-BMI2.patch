From 0269289840017b7a6c0b9f61f293895f298ccc01 Mon Sep 17 00:00:00 2001
From: jslay88 <justin.slay@gmail.com>
Date: Tue, 20 Oct 2026 11:41:38 -0600
Subject: [PATCH] Aurora: a Dawn ref that compiles with BMI2 on

266c1cf8's Abseil includes bmi2intrin.h directly, and the AppImage build turns BMI2 on with -march=x86-64-v3. 1155e0ed still contains that pin and includes immintrin.h instead. The cache descriptor on that Dawn takes its callbacks through the setters.
---
 GXRuntime/graphics/aurora/CMakeLists.txt     |  4 ++--
 GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp | 16 ++++++++++------
 2 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/GXRuntime/graphics/aurora/CMakeLists.txt b/GXRuntime/graphics/aurora/CMakeLists.txt
index 64fb9444a9..6cf3583574 100644
--- a/GXRuntime/graphics/aurora/CMakeLists.txt
+++ b/GXRuntime/graphics/aurora/CMakeLists.txt
@@ -28,8 +28,8 @@ endmacro()
 # Dependency versions
 _aurora_dependency_version(AURORA_DAWN_VERSION "v20260618.032059" "Dawn prebuilt version tag (https://github.com/encounter/dawn/releases)"
         "v20260523.201736" "v20260603.191052") # Previous versions
-_aurora_dependency_version(AURORA_DAWN_REF "266c1cf8de969a364afa4fa49311631fc99a881e" "Dawn commit ref (https://github.com/encounter/dawn)"
-        "9aa45f938d4b36626722bbfdc2f18447179337e6" "13abc3bc8ea2d3c2050f9e77a12d012108ceee24") # Previous versions
+_aurora_dependency_version(AURORA_DAWN_REF "1155e0ed531126f33a1279afa029349651ca1c93" "Dawn commit ref (https://github.com/encounter/dawn)"
+        "266c1cf8de969a364afa4fa49311631fc99a881e" "9aa45f938d4b36626722bbfdc2f18447179337e6" "13abc3bc8ea2d3c2050f9e77a12d012108ceee24") # Previous versions
 _aurora_dependency_version(AURORA_SDL3_VERSION "3.4.10" "SDL3 prebuilt version tag (https://github.com/libsdl-org/SDL/releases)")
 _aurora_dependency_version(AURORA_SDL3_REF "refs/tags/release-3.4.10" "SDL3 commit ref (https://github.com/libsdl-org/SDL)")
 _aurora_dependency_version(AURORA_NOD_VERSION "v2.0.0-alpha.10" "nod version tag (https://github.com/encounter/nod/releases)")
diff --git a/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp b/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
index 8c362f0b18..7ab3a6cd4d 100644
--- a/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
+++ b/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
@@ -6,6 +6,7 @@
 #include <cmath>
 #include <cstdint>
 #include <cstdlib>
+#include <span>
 #include <string>
 #include <string_view>
 #include <utility>
@@ -973,12 +974,15 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
     Log.info("Enabling features: {}", featureList);
     Log.info("Device lock (implicit device synchronization): {}", g_deviceLock ? "on" : "off");
 #ifdef WEBGPU_DAWN
-    wgpu::DawnCacheDeviceDescriptor cacheDescriptor({
-        .isolationKey = nullptr,
-        .loadDataFunction = load_from_cache,
-        .storeDataFunction = store_to_cache,
-        .functionUserdata = nullptr,
-    });
+    wgpu::DawnCacheDeviceDescriptor cacheDescriptor({.nextInChain = nullptr});
+    cacheDescriptor.SetDawnLoadCacheDataCallback(
+        [](std::span<const std::byte> key, std::span<std::byte> value) noexcept -> size_t {
+          return load_from_cache(key.data(), key.size(), value.data(), value.size(), nullptr);
+        });
+    cacheDescriptor.SetDawnStoreCacheDataCallback(
+        [](std::span<const std::byte> key, std::span<const std::byte> value) noexcept {
+          store_to_cache(key.data(), key.size(), value.data(), value.size(), nullptr);
+        });
 
     constexpr std::array enableToggles{
 #if _WIN32
-- 
2.46.0

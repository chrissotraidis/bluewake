From bcc1b03a4dbc05c1824092a230f9b3e9db6b1336 Mon Sep 17 00:00:00 2001
From: pdale-boop <237306950+pdale-boop@users.noreply.github.com>
Date: Wed, 14 Oct 2026 11:43:02 -0500
Subject: [PATCH 2/2] Aurora: a resize keeps the followed window size up to
 date

The window size the render worker follows (g_followSize) was only written
by the retrace service, aurora_backend_service_present. With the game held
by the settings menu that service does not run, so a resize through the
event path configured the new size and follow_surface_size could then
configure the surface back to the last cached one. resize_swapchain_internal
now stores the size it is asked for, so the cache always matches the last
resize, from either path.
---
 GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp b/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
index cac53bcd6e..8c362f0b18 100644
--- a/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
+++ b/GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp
@@ -1126,11 +1126,19 @@ void release_surface() noexcept {
   }
 }
 
+// The window's newest size in pixels (width << 32 | height), 0 for none:
+// window::follow_window_size between the game's frames, and every resize
+// here, so a resize from the event path (with the game held by a menu, the
+// retrace service that follows the window does not run) is never undone by
+// follow_surface_size going back to an older cached size.
+static std::atomic_uint64_t g_followSize{0};
+
 static void resize_swapchain_internal(uint32_t width, uint32_t height, uint32_t nativeWidth, uint32_t nativeHeight,
                                       bool force) {
   if (!g_surface || !g_device || width == 0 || height == 0 || nativeHeight == 0 || nativeWidth == 0) {
     return;
   }
+  g_followSize.store(static_cast<uint64_t>(nativeWidth) << 32 | nativeHeight, std::memory_order_relaxed);
   const bool sizeChanged = g_graphicsConfig.surfaceConfiguration.width != nativeWidth ||
                            g_graphicsConfig.surfaceConfiguration.height != nativeHeight ||
                            g_frameBuffer.size.width != width || g_frameBuffer.size.height != height;
@@ -1162,9 +1170,6 @@ static void resize_swapchain_internal(uint32_t width, uint32_t height, uint32_t
   g_CopyBindGroup = create_copy_bind_group(present_source());
 }
 
-// The window's newest size in pixels (width << 32 | height), 0 for none.
-static std::atomic_uint64_t g_followSize{0};
-
 void set_follow_size(uint32_t nativeWidth, uint32_t nativeHeight) noexcept {
   g_followSize.store(static_cast<uint64_t>(nativeWidth) << 32 | nativeHeight, std::memory_order_relaxed);
 }

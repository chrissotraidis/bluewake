+    // count, its particles pair with their own places in the frame before,
+    // and the new one grows out of the end that was there.
+    const auto trail = [](int particles) {
+      gxc::DrawPlan plan;
+      plan.match_payload = payload;
+      plan.match_payload_size = sizeof(payload);
+      plan.match_primitive = 0x98;
+      plan.match_direct_position = true;
+      plan.vertex_count = static_cast<uint32_t>(particles * 2);
+      plan.tex_address = 0x3456;
+      plan.vertices.assign(plan.vertex_count * gxc::kVertexFloats, 0.f);
+      for (int i = 0; i < particles; ++i)
+        for (int side = 0; side < 2; ++side) {
+          float* v = plan.vertices.data() + (i * 2 + side) * gxc::kVertexFloats + gxc::kVertexPosOffset / sizeof(float);
+          v[0] = 20.f * float(i - (particles - 6)); // the newest at the start, the oldest at x = 100
+          v[1] = side == 0 ? 3.f : -3.f;
+          v[2] = -400.f;
+        }
+      return plan;
+    };
+    fi::end_game_frame();
+    blend_plan(trail(6), identity);
+    fi::end_game_frame();
+    blend_plan(trail(7), identity);
+    const float* grown = fi::blended_positions();
+    CHECK(grown != nullptr && near(grown[0], -10.f) && near(grown[1], 3.f) && near(grown[3], -10.f) &&
+          near(grown[6], 0.f) && near(grown[13 * 3], 100.f));
+
     // The camera turns 12 degrees past a spark that hangs still: its corners,
     // sent in the camera's view, change every frame. It is drawn where the
     // halfway camera sees it, as the rooms around it are.
diff --git a/GXRuntime/graphics/gxcore/src/gxcore.cpp b/GXRuntime/graphics/gxcore/src/gxcore.cpp
index 98cd60e4da..b6a3300203 100644
--- a/GXRuntime/graphics/gxcore/src/gxcore.cpp
+++ b/GXRuntime/graphics/gxcore/src/gxcore.cpp
@@ -646,7 +646,13 @@ void GxCoreState::build_draw_plan_into(const ar::ConsumedDraw& draw,
   plan.match_primitive = draw.primitive;
   plan.match_vtx_fmt = draw.vtx_fmt;
   plan.match_vertex_stride = draw.vertex_size;
-  if (bp_valid_[kDrawTagRegister]) {
+  // A particle is drawn with at most eight vertices (a cross is two quads).
+  // A draw with more is not one particle's: an emitter's callback draws it
+  // after its last particle (a strip through all of them, the wind's lines in
+  // the sky) and found that particle's tag, a different particle every frame,
+  // so it never had a counterpart and moved at 30 FPS.
+  constexpr std::uint32_t kParticleVertices = 8;
+  if (bp_valid_[kDrawTagRegister] && draw.vertex_count <= kParticleVertices) {
     plan.draw_tag = bp_regs_[kDrawTagRegister];
     plan.draw_tag_age = bp_valid_[kDrawTagAgeRegister] ? bp_regs_[kDrawTagAgeRegister] : 0u;
   }

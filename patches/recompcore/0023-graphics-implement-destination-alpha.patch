 .../graphics/aurora/lib/gfx/gxcore_draw.cpp   | 42 ++++++++++++++-----
 .../graphics/aurora/lib/gfx/gxcore_draw.hpp   |  5 ++-
 GXRuntime/graphics/aurora/lib/webgpu/gpu.cpp  |  7 +++-
 GXRuntime/graphics/aurora/lib/webgpu/gpu.hpp  |  1 +
 .../include/gxruntime/gxcore/gxcore.hpp       |  1 +
 .../include/gxruntime/gxcore/shader.hpp       |  5 ++-
 GXRuntime/graphics/gxcore/src/gxcore.cpp      |  9 ++++
 .../graphics/gxcore/src/gxcore_shader.cpp     | 38 +++++++++++++++--
 .../gxcore/tests/gxcore_wgsl_test.cpp         | 25 +++++++++++
 10 files changed, 117 insertions(+), 20 deletions(-)

diff --git a/GXRuntime/backends/aurora/aurora_backend.cpp b/GXRuntime/backends/aurora/aurora_backend.cpp

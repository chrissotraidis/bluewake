 bool initialize(AuroraBackend backend, bool allowCpu);
 void shutdown();
diff --git a/GXRuntime/graphics/gxcore/include/gxruntime/gxcore/gxcore.hpp b/GXRuntime/graphics/gxcore/include/gxruntime/gxcore/gxcore.hpp
index db4c662446..a46f1ea49e 100644
--- a/GXRuntime/graphics/gxcore/include/gxruntime/gxcore/gxcore.hpp
+++ b/GXRuntime/graphics/gxcore/include/gxruntime/gxcore/gxcore.hpp

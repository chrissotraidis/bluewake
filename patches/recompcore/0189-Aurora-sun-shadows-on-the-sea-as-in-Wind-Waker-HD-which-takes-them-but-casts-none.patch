From 1cc1699c1c33e20015b759c32d11d0cf3ae51b35 Mon Sep 17 00:00:00 2001
From: pdale-boop <237306950+pdale-boop@users.noreply.github.com>
Date: Wed, 28 Oct 2026 19:23:49 -0500
Subject: [PATCH] Aurora: sun shadows on the sea as in Wind Waker HD, which
 takes them but casts none

The sea takes sun shadows but casts none, as in Wind Waker HD.

The sea's surface (draws over 20,000 units wide and flatter than 2%, from the
water layer experiment) leaves the sun shadow map. In the map a swell's crest
shaded the trough behind it: specks along the horizon at sea, and at dusk a
smear around the sea platforms' legs, whose own shadows came away from their
feet. HD's sea casts nothing either. DOL_AURORA_SUN_SHADOW_MAP_SEA_CASTS=1
puts it back.

With the sea out of the map, the sea rise (nothing up to 15 units above the
water shades it) had nothing left to do but drop the foot of what stands in
the water, a light strip under the boat's hull. It now defaults to 0, which turns the rule off (at 0 its fade still lit
up to 45 units of what stood at a low sun);
DOL_AURORA_SUN_SHADOW_MAP_SEA_RISE=15 brings it back.

Arch (Vulkan), saved states, cloud shadows off: the boat, three sea platforms
(one at dusk), the Outset jetty and sunrise, and four under sail. The hull's
and the dusk legs' shadows meet them; nothing else changed.

No slope or normal bias on the sea, which can't shade itself.

The bias keeps a surface from shading itself. The sea casts nothing now, so it
has nothing to guard against, and with it a sea platform's leg and its ladder,
further from the camera at a low sun, had their shadows start well away from
where they stand in the water (the far cascade's slope bias, up to 8 x 10 of its
texels on water seen at a grazing sun). DOL_AURORA_SUN_SHADOW_MAP_SEA_BIAS=1
gives the sea the full bias again.

Arch (Vulkan), saved states, cloud shadows off: the platform's leg and ladder
shadows meet their feet; the boat, the dusk platforms, the Outset jetty, shore
and sunrise show no change and no speckle.

The gap fill counts only what the sun shadow map holds.

The gap fill steps toward the sun through the depth buffer to find a shadow's
foot again, and took any surface it met as a caster. It was kept off the sea
by height (40 units over the sea's level), but the swells' crests stand higher:
far out at sunrise they dotted the sea with their shade and threw shadow wings
beside the boat's bow spray. A surface a step finds now counts unless the map
has nothing there, so the sea, which casts nothing, can't cast through the gap
fill either, and the gap fill runs on the sea too. The check is one-sided: a
surface the map holds something nearer the sun than (solid, in its own shadow)
still counts. Checked both ways, an island's far side, which the map holds
only in patches far off, came out in blotches.

Arch (Vulkan), saved states, cloud shadows off: the sunrise dots and the wings
are gone; an island's far side is dark as on main; a sea platform at dusk, the
Outset jetty and Link on Outset's grass are unchanged.
---
 .../graphics/aurora/lib/gfx/gxcore_draw.cpp   | 28 ++++++++++-
 GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp | 48 +++++++++++++++----
 2 files changed, 66 insertions(+), 10 deletions(-)

diff --git a/GXRuntime/graphics/aurora/lib/gfx/gxcore_draw.cpp b/GXRuntime/graphics/aurora/lib/gfx/gxcore_draw.cpp
index e2ef28576d..d255061ff6 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/gxcore_draw.cpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/gxcore_draw.cpp
@@ -437,6 +437,31 @@ bool sun_caster_alpha(const gxc::PipelineKey& key) {
          key.blend_subtract == 0u && key.primitive_topology == 0u && key.shader.textured != 0u &&
          !alpha_test_always_passes(key.shader) && !alpha_test_always_fails(key.shader);
 }
+
+// The sea's surface, which the solid caster rule takes (it is opaque and
+// writes depth): strips the game lays around the player in world space, about
+// 51,000 units across, and flat quads out to 450,000 for the distance, flat
+// but for the waves. Nothing else is that wide and that flat. As in Wind Waker
+// HD it takes shadows but casts none: in the map a swell's crest shaded the
+// trough behind it, and a tower standing there lost the foot of its shadow.
+// DOL_AURORA_SUN_SHADOW_MAP_SEA_CASTS=1 puts it back in the map.
+bool sea_surface(const gxc::DrawPlan& plan) {
+  static const bool s_seaCasts = [] {
+    const char* value = std::getenv("DOL_AURORA_SUN_SHADOW_MAP_SEA_CASTS");
+    return value != nullptr && value[0] == '1';
+  }();
+  if (s_seaCasts || plan.constants.projection[3][3] == 1.f || plan.vertices.size() < 3)
+    return false;
+  float lo[3] = {plan.vertices[0], plan.vertices[1], plan.vertices[2]};
+  float hi[3] = {lo[0], lo[1], lo[2]};
+  for (size_t v = gxc::kVertexFloats; v + 2 < plan.vertices.size(); v += gxc::kVertexFloats)
+    for (int c = 0; c < 3; ++c) {
+      lo[c] = std::min(lo[c], plan.vertices[v + c]);
+      hi[c] = std::max(hi[c], plan.vertices[v + c]);
+    }
+  const float wide = std::max(hi[0] - lo[0], hi[2] - lo[2]);
+  return wide >= 20000.f && hi[1] - lo[1] <= 0.02f * wide;
+}
 } // namespace
 
 bool needs_early_depth_emulation(const gxc::PipelineKey& key) {
@@ -2648,7 +2673,8 @@ bool submit_draw_plan(const gxc::DrawPlan& plan) {
       .uberPipeline = uberPipeline,
       .uberPixelRange = uberPixelRange,
       .uberTextureBindGroup = uberTextureBindGroup,
-      .sunCaster = sun_caster(plan.pipeline) || clothCaster || blendedCaster,
+      .sunCaster = (sun_caster(plan.pipeline) || clothCaster || blendedCaster) &&
+                   !(sun_caster(plan.pipeline) && post_fx::sun_shadow_map_enabled() && sea_surface(plan)),
       .posMtxIdx = plan.pipeline.shader.has_pos_mtx_idx != 0,
       // DOL_AURORA_SUN_CASTER_LOG=1: why a cloth's or wake's draw (a scope)
       // does or does not cast, once per distinct state (local debug).
diff --git a/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp b/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp
index 9ce11a737d..5d00c6e695 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp
@@ -44,7 +44,8 @@ float g_sunMapContact = 300.f;   // the screen's steps' reach, for what the map
 int g_sunMapDebug = 0;           // DOL_AURORA_SUN_SHADOW_MAP_DEBUG=1: the map's shadow alone, gray outside it; 2: the map itself, depth as contour bands
 bool g_sunMapSteps = false;
 float g_sunMapSeaLow = 40.f;      // DOL_AURORA_SUN_SHADOW_MAP_SEA_LOW: below the sea's height plus this, a surface counts as sea
-float g_sunMapSeaRise = 15.f;     // DOL_AURORA_SUN_SHADOW_MAP_SEA_RISE: what stands no higher than this above the sea doesn't shade it
+float g_sunMapSeaBias = 0.f;      // DOL_AURORA_SUN_SHADOW_MAP_SEA_BIAS: the share of the slope and normal bias the sea keeps (1 before it left the map)
+float g_sunMapSeaRise = 0.f;      // DOL_AURORA_SUN_SHADOW_MAP_SEA_RISE: what stands no higher than this above the sea doesn't shade it (15 before the sea left the map)
 bool g_sunMapSmooth = true;
 bool g_sunMapGapFill = true;      // DOL_AURORA_SUN_SHADOW_MAP_GAP_FILL=0: no steps over the bias's reach
 uint32_t g_sunMapTaps = 12;       // DOL_AURORA_SUN_SHADOW_MAP_TAPS: lookups in each shadow's filter disc (6 to 12)
@@ -748,7 +749,8 @@ override smooth_terms: f32 = 1.0;
 override sea_low: f32 = 40.0;
 override gap_fill: f32 = 1.0;
 override taps: f32 = 12.0;
-override sea_rise: f32 = 15.0;
+override sea_rise: f32 = 0.0;

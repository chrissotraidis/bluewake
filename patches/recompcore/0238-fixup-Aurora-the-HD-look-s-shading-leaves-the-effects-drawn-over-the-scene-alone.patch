From bd384a5825c289815ab3aa04a4a2b7d767ff03e4 Mon Sep 17 00:00:00 2001
From: pdale-boop <237306950+pdale-boop@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:09:55 -0600
Subject: [PATCH] fixup! Aurora: the HD look's shading leaves the effects drawn
 over the scene alone

Two Dragon Roost Cavern effects from Dale's play (Nov 3):

- The lava geysers' pale core stayed blue in the shade: of each geyser's
  three large layers, the middle one adds half the game's light to its
  colour (C1 + 0.5 x RASC), so it wasn't a glow model and was shaded as
  scenery. A glow model may now take the rasterized colour when its
  textures only cut its shape (their alpha alone is used); untextured,
  that colour is lit scenery's. And an effect drawn at its own depth (a
  geyser in front of the far wall it hides) keeps its share near or far:
  the cover faded out from 3,000 units by the depth behind it, the far
  wall's, and the geysers, about 3,000 away, took part of the shade.
- The dust a shutting door raises was too see-through: a dark effect
  blended over the scene adds little over black, so its share (its
  brightest channel times 2) left most of the pixel shaded as the floor
  behind it, and the floor's shadows showed through. The effects are now
  drawn into the mask a second time over white: 1 - white + black is a
  blended effect's opacity (an added one's colour, as before), and the
  larger of the two is its share. DOL_AURORA_EFFECT_MASK_OPACITY=0 keeps
  the colour alone.

A small pass makes the cover the shading reads from both masks, with the
own-depth flag in its alpha. With the look off, nothing changes; the
look's frames without effects are unchanged, and frame dumps from four
other save states match within noise.
---
 GXRuntime/graphics/aurora/lib/gfx/common.cpp  |  36 +++
 .../graphics/aurora/lib/gfx/gxcore_draw.cpp   |  18 +-
 GXRuntime/graphics/aurora/lib/gfx/post_fx.cpp | 260 +++++++++++++++---
 GXRuntime/graphics/aurora/lib/gfx/post_fx.hpp |   5 +
 4 files changed, 280 insertions(+), 39 deletions(-)

diff --git a/GXRuntime/graphics/aurora/lib/gfx/common.cpp b/GXRuntime/graphics/aurora/lib/gfx/common.cpp
index 8796173180..65f3baf905 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/common.cpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/common.cpp
@@ -2430,6 +2430,42 @@ static void encode_effect_mask(const wgpu::CommandEncoder& cmd, FramePacket& fra
     render_pass(pass, frame, passInfo, 0, end, true);
   }
   pass.End();
+  // Again over white, for their opacity (post_fx.hpp effect_white_target()): a dark effect blended over the scene
+  // (the dust a shutting door raises) adds little over black but hides what is behind it. Against a fresh copy of
+  // the sea mask's depth when the effects drawn at their own depth wrote theirs into the first.
+  if (!post_fx::effect_mask_opacity())
+    return;
+  const wgpu::TextureView whiteDepthView =
+      own ? post_fx::effect_mask_depth(cmd, passInfo.targetSize) : wgpu::TextureView{};
+  const bool whiteOwn = own && static_cast<bool>(whiteDepthView);
+  const std::array whiteAttachments{wgpu::RenderPassColorAttachment{
+      .view = post_fx::effect_white_target(passInfo.targetSize, webgpu::g_frameBuffer.texture.GetFormat()),
+      .loadOp = clear ? wgpu::LoadOp::Clear : wgpu::LoadOp::Load,
+      .storeOp = wgpu::StoreOp::Store,
+      .clearValue = {1.0, 1.0, 1.0, 1.0},
+  }};
+  const wgpu::RenderPassDepthStencilAttachment whiteDepth{
+      .view = whiteOwn ? whiteDepthView : passInfo.depthStencilView,
+      .depthLoadOp = wgpu::LoadOp::Load,
+      .depthStoreOp = wgpu::StoreOp::Store,
+      .stencilLoadOp = passInfo.hasStencil ? wgpu::LoadOp::Load : wgpu::LoadOp::Undefined,
+      .stencilStoreOp = passInfo.hasStencil ? wgpu::StoreOp::Store : wgpu::StoreOp::Undefined,
+  };
+  const wgpu::RenderPassDescriptor whiteDescriptor{
+      .label = "Effects mask (over white)",
+      .colorAttachmentCount = whiteAttachments.size(),
+      .colorAttachments = whiteAttachments.data(),
+      .depthStencilAttachment = &whiteDepth,
+      .timestampWrites = webgpu::gpu_prof::pass_writes("Effects mask (over white)"),
+  };
+  auto whitePass = cmd.BeginRenderPass(&whiteDescriptor);
+  if (whiteOwn) {
+    render_pass(whitePass, frame, passInfo, 0, end, true, 1);
+    render_pass(whitePass, frame, passInfo, 0, end, true, 2);
+  } else {
+    render_pass(whitePass, frame, passInfo, 0, end, true);
+  }
+  whitePass.End();
 }
 #endif
 

+// The colour peek's GPU path needs a device, so the command-level tests take the same stub
+// treatment the depth peek gets. What it does not restate is the logic: the word layout and the
+// guest-to-target map come from the header, which the module itself includes, so the tests exercise
+// one definition rather than a copy of it.
+namespace aurora::gfx::color_peek {
+namespace {
+bool s_snapshotRequested = false;
+Mapping s_mapping{};
+std::vector<uint32_t> s_data;
+} // namespace
+
+void initialize() {}
+void shutdown() {}
+void request_snapshot() noexcept { s_snapshotRequested = true; }
+void encode_frame_snapshot(const wgpu::CommandEncoder& cmd, const wgpu::Texture& colorTexture,
+                           wgpu::TextureFormat format, wgpu::Extent3D sourceSize,
+                           uint32_t msaaSamples) noexcept {}
+void after_submit() noexcept {}
+
+bool read_latest(uint16_t x, uint16_t y, uint32_t& argb) noexcept {
+  uint32_t index = 0;
+  if (s_data.empty() || !map_guest_to_source(s_mapping, x, y, index) || index >= s_data.size()) {
+    return false;
+  }
+  argb = s_data[index];
+  return true;
+}
+
+namespace testing {
+void reset() noexcept {
+  s_snapshotRequested = false;
+  s_mapping = {};
+  s_data.clear();
+}
+
+bool snapshot_requested() noexcept { return s_snapshotRequested; }
+
+void set_latest(uint32_t width, uint32_t height, const std::vector<uint32_t>& data) {
+  s_mapping = Mapping{.srcWidth = width, .srcHeight = height};
+  s_data = data;
+}
+} // namespace testing
+} // namespace aurora::gfx::color_peek

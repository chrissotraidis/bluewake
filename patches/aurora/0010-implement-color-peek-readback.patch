+TEST(GXColorPeekTest, ArgbWordPutsAlphaInTheHighByte) {
+  // The guest's own capture pass writes its photo index with GXSetDstAlpha(col * 4), leaves colour
+  // updates off and alpha updates on, then reads `sp8 >> 26`. The index therefore comes back whole
+  // only if alpha is the high byte of the peeked word.
+  using aurora::gfx::color_peek::argb_from_rgba8;
+  EXPECT_EQ(argb_from_rgba8(0x11, 0x22, 0x33, 0xFC), 0xFC112233u);
+
+  const u32 index = 37;
+  const u32 dstAlpha = index * 4;
+  EXPECT_EQ(argb_from_rgba8(0xFF, 0x00, 0x00, static_cast<u8>(dstAlpha)) >> 26, index);
+}
+
+TEST_F(GXFifoTest, PeekARGB_FallsBackToZeroAndRequestsSnapshot) {
+  u32 argb = 0xFFFFFFFF;
+  GXPeekARGB(10, 20, &argb);
+
+  EXPECT_EQ(argb, 0u);
+  EXPECT_FALSE(aurora::gfx::color_peek::testing::snapshot_requested());
+
+  auto bytes = capture_fifo();
+  EXPECT_TRUE(has_aurora_cmd(bytes, GX_AURORA_REQUEST_COLOR_SNAPSHOT));
+  decode_fifo(bytes);
+  EXPECT_TRUE(aurora::gfx::color_peek::testing::snapshot_requested());
+}
+
+TEST_F(GXFifoTest, PeekARGB_ReturnsLatestCompletedSnapshot) {
+  aurora::gfx::color_peek::testing::set_latest(
+      2, 2, {0xFF000001u, 0xFF000002u, 0xFF000003u, 0xFC000004u});
+
+  u32 argb = 0;
+  GXPeekARGB(1, 1, &argb);
+
+  EXPECT_EQ(argb, 0xFC000004u);
+  EXPECT_FALSE(aurora::gfx::color_peek::testing::snapshot_requested());
+
+  auto bytes = capture_fifo();
+  decode_fifo(bytes);
+  EXPECT_TRUE(aurora::gfx::color_peek::testing::snapshot_requested());
+}
+
+TEST_F(GXFifoTest, PeekARGB_OutOfRangeFallsBackToZero) {
+  aurora::gfx::color_peek::testing::set_latest(1, 1, {0xFC000001u});
+
+  u32 argb = 0xFFFFFFFF;
+  GXPeekARGB(1, 0, &argb);
+
+  EXPECT_EQ(argb, 0u);
+  EXPECT_FALSE(aurora::gfx::color_peek::testing::snapshot_requested());
+
+  auto bytes = capture_fifo();
+  decode_fifo(bytes);
+  EXPECT_TRUE(aurora::gfx::color_peek::testing::snapshot_requested());
+}

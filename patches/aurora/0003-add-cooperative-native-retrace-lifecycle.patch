+void VIWaitForRetrace() {
+  auto& state = aurora::vi::retrace_state();
+  bool owner;
+  std::chrono::nanoseconds period;
+  {
+    std::lock_guard lock(state.mutex);
+    owner = state.owner == std::this_thread::get_id();
+    period = state.period;
+  }
+  if (owner) {
+    while (!aurora::vi::service_retrace()) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  } else {
+    // DVD retry workers also wait on VI. They wait in game time but never run
+    // callbacks or take ownership from the video thread, including before init.
+    const auto until = aurora::time::game_clock::now() + period;
+    while (aurora::time::game_clock::now() < until) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}

+namespace {
+struct RetraceState {
+  std::mutex mutex;
+  std::thread::id owner;
+  std::chrono::nanoseconds period{1000000000 / 60};
+  time::game_clock::time_point last = time::game_clock::now();
+  u32 count = 0;
+  VIRetraceCallback pre = nullptr;
+  VIRetraceCallback post = nullptr;
+  void* configuredBuffer = nullptr;
+  void* nextBuffer = nullptr;
+  void* currentBuffer = nullptr;
+  bool configuredBlack = true;
+  bool nextBlack = true;
+  bool currentBlack = true;
+  bool flushed = false;
+  bool dispatching = false;
+};
+RetraceState& retrace_state() {
+  static RetraceState state;
+  return state;
+}
+} // namespace
+
+bool output_black() noexcept {
+  auto& state = retrace_state();
+  std::lock_guard lock(state.mutex);
+  return state.currentBlack;
+}
+
+// Cooperative native VI: callbacks execute on the VI/graphics owner, never on
+// an unrelated timer thread. Call at native frame/wait boundaries. Late polling
+// coalesces elapsed retraces; this is not console interrupt-latency emulation.
+bool service_retrace() {
+  auto& state = retrace_state();
+  VIRetraceCallback pre;
+  u32 count;
+  {
+    std::lock_guard lock(state.mutex);
+    if (state.owner != std::this_thread::get_id() || state.dispatching) std::abort();
+    const auto now = time::game_clock::now();
+    // Native cadence policy: PAL 50 Hz, other supported modes 60 Hz. Physical
+    // scanline/field timing is not represented by the host window.
+    const auto period = state.period;
+    if (now - state.last < period) return false;
+    const auto elapsed = (now - state.last) / period;
+    state.last += period * elapsed;
+    state.count += static_cast<u32>(elapsed);
+    count = state.count;
+    pre = state.pre;
+    state.dispatching = true;
+  }
+  if (pre) pre(count);
+  VIRetraceCallback post;
+  {
+    std::lock_guard lock(state.mutex);
+    // Original VI ordering: pre callback, apply flushed settings, post callback.
+    if (state.flushed) {
+      state.currentBuffer = state.nextBuffer;
+      state.currentBlack = state.nextBlack;
+      state.flushed = false;
+    }
+    post = state.post;
+  }
+  if (post) post(count);
+  {
+    std::lock_guard lock(state.mutex);
+    state.dispatching = false;
+  }
+  return true;
+}
 

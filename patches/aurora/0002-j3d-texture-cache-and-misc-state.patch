diff --git a/lib/dolphin/gx/GXTexture.cpp b/lib/dolphin/gx/GXTexture.cpp
--- a/lib/dolphin/gx/GXTexture.cpp
+++ b/lib/dolphin/gx/GXTexture.cpp
@@ -342,2 +342,20 @@
-// TODO GXInitTexCacheRegion
+void GXInitTexCacheRegion(GXTexRegion* region, GXBool is_32b_mipmap, u32 tmem_even,
+                          GXTexCacheSize size_even, u32 tmem_odd, GXTexCacheSize size_odd) {
+  // Original SDK register packing; cache addresses are TMEM offsets, not host pointers.
+  CHECK(region != nullptr, "GXInitTexCacheRegion: null region");
+  CHECK(static_cast<u32>(size_even) <= 2 && static_cast<u32>(size_odd) <= 3,
+        "GXInitTexCacheRegion: invalid cache size");
+  const u32 even = static_cast<u32>(size_even) + 3;
+  const u32 odd = size_odd == GX_TEXCACHE_NONE ? 0 : static_cast<u32>(size_odd) + 3;
+  const u32 image1 = ((tmem_even >> 5) & 0x7fff) | (even << 15) | (even << 18);
+  const u32 image2 = ((tmem_odd >> 5) & 0x7fff) | (odd << 15) | (odd << 18);
+  // Preserve the SDK's untouched preload-size and trailing bytes. memcpy also
+  // avoids inventing an aliased internal structure for the public opaque object.
+  std::memcpy(reinterpret_cast<u8*>(region), &image1, sizeof(image1));
+  std::memcpy(reinterpret_cast<u8*>(region) + 4, &image2, sizeof(image2));
+  auto* bytes = reinterpret_cast<u8*>(region);
+  bytes[12] = is_32b_mipmap;
+  bytes[13] = 1;
+}

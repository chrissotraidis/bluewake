diff --git a/lib/dolphin/gx/GXManage.cpp b/lib/dolphin/gx/GXManage.cpp
--- a/lib/dolphin/gx/GXManage.cpp
+++ b/lib/dolphin/gx/GXManage.cpp
@@ -15,2 +15,20 @@
 extern "C" {
+void GXSetMisc(GXMiscToken token, u32 val) {
+  switch (token) {
+  case GX_MT_NULL:
+    break;
+  case GX_MT_XF_FLUSH:
+    __gx->vNum = static_cast<u16>(val);
+    // Aurora derives the zero-count condition from vNum rather than storing
+    // the SDK's redundant vNumNot byte; its flush service owns bpSent.
+    __gx->bpSent = 1;
+    if (__gx->vNum != 0)
+      __gx->dirtyState |= 1u << 3;
+    break;
+  case GX_MT_DL_SAVE_CONTEXT:
+    __gx->dlSaveContext = val != 0;
+    break;
+  }
+}

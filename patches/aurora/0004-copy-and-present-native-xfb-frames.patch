+struct DisplayCopyState {
+  aurora::gfx::ClipRect source{0, 0, 640, 480};
+  u32 width = 640;
+  u32 scale = 256;
+};
+DisplayCopyState displayCopy;
+u32 xfb_lines(u32 height, u32 scale) {
+  AURORA_ASSERT(height > 0 && scale > 0, "Invalid display copy size/scale");
+  u32 lines = (height - 1) * 256 / scale + 1;
+  if (scale > 128 && scale < 256) {
+    while (scale % 2 == 0) scale /= 2;
+    if (height % scale == 0) ++lines;
+  }
+  return std::min(lines, 1024u);
+}

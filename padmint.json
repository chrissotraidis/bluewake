{
  "schema_version": 1,
  "id": "bluewake",
  "name": "BlueWake",
  "game": "The Legend of Zelda: The Wind Waker (GameCube, GZLE01)",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "gamecube-disc",
      "formats": [
        "iso"
      ],
      "description": "Your own GZLE01 disc image; the backend verifies it."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental",
        "linux-x86_64": "experimental",
        "linux-arm64": "experimental"
      },
      "tools": [
        "git",
        "cmake",
        "ninja",
        "libcxx"
      ],
      "published_app": "BlueWake-v{version}-ios-unsigned.ipa",
      "ios_module": {
        "file": "{work}/composite-ios/gGZLE01_recomp.dylib",
        "into": "Frameworks/gGZLE01_recomp.dylib"
      },
      "steps": [
        {
          "stage": "translate",
          "command": [
            "/bin/bash",
            "{repo}/scripts/builder/build.sh",
            "{disc}",
            "--out",
            "{work}",
            "--jobs",
            "{jobs}",
            "--source-only"
          ]
        },
        {
          "stage": "configure",
          "command": [
            "cmake",
            "-S",
            "{repo}/cmake/composite",
            "-B",
            "{work}/composite-ios",
            "-G",
            "Ninja",
            "-DCMAKE_TOOLCHAIN_FILE={ios_toolchain}",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DCMAKE_C_FLAGS=-mcpu=apple-a13",
            "-DCOMPOSITE_OPTIMIZATION_LEVEL=2",
            "-DCOMPOSITE_DIR={work}/composite-src",
            "-DGXRUNTIME_DIR={repo}/ref/recompcore/GXRuntime",
            "-DABI_DIR={repo}/ref/recompcore/Source/Core/Core/PowerPC/StaticRecomp"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "cmake",
            "--build",
            "{work}/composite-ios",
            "-j",
            "{jobs}"
          ]
        }
      ],
      "output": "ipa",
      "check": "ipa"
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 25,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "player": true,
        "note": "Install full Xcode and its iOS platform, then select that Xcode in Xcode Settings > Locations > Command Line Tools; Command Line Tools alone are not enough.",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcrun",
        "label": "Xcode iPhoneOS SDK",
        "version_args": [
          "--sdk",
          "iphoneos",
          "--show-sdk-path"
        ],
        "player": true,
        "note": "Install full Xcode and its iOS platform, then select that Xcode in Xcode Settings > Locations > Command Line Tools; Command Line Tools alone are not enough.",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cc",
        "label": "C compiler",
        "version_args": [
          "--version"
        ],
        "player": true,
        "hosts": [
          "linux-x86_64",
          "linux-arm64"
        ],
        "note": "Install a C compiler for the disc tool, for example: sudo apt install build-essential"
      }
    ]
  },
  "stages": [
    "preflight",
    "dependencies",
    "extract",
    "translate",
    "generate",
    "mods",
    "train-build",
    "train-run",
    "train-merge",
    "compile",
    "app",
    "package"
  ],
  "publication": {
    "public_binaries": false,
    "reason": "The release publishes the app without game code; PadMint adds the module translated from the player's own disc, which stays personal."
  }
}
